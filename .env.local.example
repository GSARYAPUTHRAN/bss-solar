# Supabase project credentials (Project Settings -> API)
# Production: create project at https://supabase.com/dashboard — see DEPLOY.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for admin actions (e.g. adding team members).
# Local: `npx supabase status` | Production: service_role key from Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Web Push (optional) -----------------------------------------------------
# Browser push notifications. Generate a pair ONCE per deployment with
#   node scripts/generate-vapid-keys.mjs
# Without both keys the in-app bell still works; push is shown as "not set up".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never commit a real value.
VAPID_PRIVATE_KEY=
# Contact the push services can reach about abuse (mailto: or https: URL).
# Defaults to mailto:<company email from src/lib/constants.ts> when unset.
VAPID_SUBJECT=

# --- Scheduled jobs ----------------------------------------------------------
# Bearer secret for /api/cron/daily (feasibility alerts; vercel.json runs it at
# 08:00 IST). Vercel sends it automatically when set in the project's env.
# Unset = the endpoint refuses every request. Generate: openssl rand -hex 32
CRON_SECRET=
